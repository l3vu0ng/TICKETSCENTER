<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${pageTitle}" default="TicketsCenter"/></title>
    <link rel="icon" href="data:,">
    <link rel="stylesheet" href="<c:url value='/webjars/bootstrap/5.3.0/css/bootstrap.min.css'/>">
    <link rel="stylesheet" href="<c:url value='/assets/css/app.css'/>">
    <script src="<c:url value='/assets/js/api-client.js'/>" defer></script>
    <script src="<c:url value='/assets/js/ui-state.js'/>" defer></script>
</head>
<body data-context-path="<c:out value='${pageContext.request.contextPath}'/>">
<a class="skip-link" href="#main-content">Bỏ qua điều hướng</a>
<header class="site-header">
    <a class="brand" href="<c:url value='/events'/>">TicketsCenter</a>
    <nav aria-label="Điều hướng chính">
        <a href="<c:url value='/events'/>">Sự kiện</a>
        <c:choose>
            <c:when test="${not empty currentUser}">
                <a href="<c:url value='/me/tickets'/>">Vé của tôi</a>
                <a href="<c:url value='/me/profile'/>"><c:out value="${currentUser.fullName}"/></a>
                <c:forEach items="${memberships.items}" var="membership">
                    <c:if test="${membership.active and membership.organizationStatus eq 'APPROVED'}">
                        <c:choose>
                            <c:when test="${membership.role eq 'MANAGER'}">
                                <a href="<c:url value='/organizations/${membership.organizationId}/events'/>"><c:out value="${membership.organizationName}"/></a>
                            </c:when>
                            <c:when test="${membership.role eq 'CHECK_IN_STAFF'}">
                                <a href="<c:url value='/checkin/events'/>">Check-in · <c:out value="${membership.organizationName}"/></a>
                            </c:when>
                        </c:choose>
                    </c:if>
                </c:forEach>
                <c:if test="${currentUser.platformRole eq 'ADMIN'}">
                    <a href="<c:url value='/admin'/>">Quản trị</a>
                </c:if>
            </c:when>
            <c:otherwise><a href="<c:url value='/auth'/>">Đăng nhập</a></c:otherwise>
        </c:choose>
    </nav>
</header>
<main id="main-content" class="page-container">
