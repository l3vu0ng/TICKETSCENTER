# TicketsCenter environment variable template
# Copy to .env and fill in real values. NEVER commit .env to Git.

# Database
TC_SQL_HOST=localhost\SQLEXPRESS
TC_DATABASE=ticketscenter_dev
TC_SQL_PORT=1433
# TC_DB_USER=     # Leave blank to use Windows Integrated Authentication
# SQLCMDPASSWORD= # For sqlcmd SQL auth only; do not use -P flag

# Test database (separate from dev — used by sqlserver-it profile)
TC_TEST_DATABASE=ticketscenter_test

# Application
TC_APP_BASE_URL=http://localhost:8080/ticketscenter
TC_APP_ENV=development
TC_SESSION_TIMEOUT_MINUTES=30
TC_DB_POOL_SIZE=5

# Demo mode — enables admin/admin shortcut locally ONLY
# NEVER enable in production
TC_DEMO_ADMIN_ENABLED=false
# TC_DEMO_ADMIN_USERNAME=admin
# TC_DEMO_ADMIN_EMAIL=      # Set to a real address for public deployment

# OTP / Security
TC_OTP_HMAC_SECRET=        # 32+ random bytes, base64 encoded

# Mail
TC_MAIL_HOST=smtp.example.com
TC_MAIL_PORT=587
TC_MAIL_USER=              # SMTP user
# TC_MAIL_PASSWORD=        # SMTP password — load as env var, never log
TC_MAIL_FROM=no-reply@example.com
TC_MAIL_TIMEOUT_MS=10000
