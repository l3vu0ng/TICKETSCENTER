# Export these variables in the launcher. The application does not parse .env files.
TC_SQL_HOST=localhost\SQLEXPRESS
TC_SQL_PORT=1433
TC_DATABASE=ticketscenter_dev
TC_TEST_DATABASE=ticketscenter_test
TC_DB_POOL_SIZE=5
TC_DB_TIMEOUT_MS=2000
TC_DB_TRUST_SERVER_CERTIFICATE=false

# The broker must not be sysadmin/db_owner. SQL authentication requires both values.
# TC_DB_USER=
# TC_DB_PASSWORD=
# SQLCMDPASSWORD=          # sqlcmd only; never use the -P argument

# EXECUTE AS targets must be database USERS, not database roles.
# Vương supplies these mappings and the broker's limited IMPERSONATE grants.
TC_PRINCIPAL_BUYER=tc_buyer
TC_PRINCIPAL_MANAGER=tc_manager
TC_PRINCIPAL_CHECK_IN=tc_checkin
TC_PRINCIPAL_PLATFORM_ADMIN=tc_platform_admin
TC_PRINCIPAL_AUTH_TECH=tc_auth_tech
TC_PRINCIPAL_WORKER_TECH=tc_worker_tech

TC_APP_BASE_URL=http://localhost:8080/ticketscenter
TC_APP_ENV=development
TC_SESSION_TIMEOUT_MINUTES=30
TC_DEMO_ADMIN_ENABLED=false
TC_OTP_HMAC_SECRET=

TC_MAIL_HOST=
TC_MAIL_PORT=587
TC_MAIL_USER=
# TC_MAIL_PASSWORD=
TC_MAIL_FROM=
TC_MAIL_TIMEOUT_MS=10000
